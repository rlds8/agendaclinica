<%- include("../partials/cabecalho.ejs") %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Pacientes</h1>
  <a href="/paciente/add" class="btn btn-primary">+ Nova Paciente</a>
</div>

<form method="get" action="/paciente/lst" class="row g-2 mb-3">
  <div class="col-md-6">
    <input type="text" name="pesquisa" class="form-control" placeholder="Pesquisar por nome ou CPF..." value="<%= pesquisa %>">
  </div>
  <div class="col-auto">
    <button type="submit" class="btn btn-outline-primary">Pesquisar</button>
    <% if (pesquisa) { %>
      <a href="/paciente/lst" class="btn btn-outline-secondary">Limpar</a>
    <% } %>
  </div>
</form>

<div class="table-responsive">
  <table class="table table-striped table-hover bg-white shadow-sm align-middle">
    <thead class="table-primary">
      <tr>
        <th>Nome</th>
        <th>CPF</th>
        <th>Telefone</th>
        <th>Convênio</th>
        <th class="text-end">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% if (pacientes.length === 0) { %>
        <tr>
          <td colspan="5" class="text-center text-muted py-3">Nenhuma paciente encontrada.</td>
        </tr>
      <% } %>
      <% pacientes.forEach(paciente => { %>
        <tr>
          <td><%= paciente.nome %></td>
          <td><%= paciente.cpf %></td>
          <td><%= paciente.telefone %></td>
          <td><%= paciente.convenio %></td>
          <td class="text-end">
            <a href="/paciente/ver/<%= paciente._id %>" class="btn btn-info btn-sm text-white">Visualizar</a>
            <a href="/paciente/edt/<%= paciente._id %>" class="btn btn-warning btn-sm">Editar</a>
            <form method="post" action="/paciente/del/<%= paciente._id %>" class="d-inline" onsubmit="return confirm('Deseja realmente excluir esta paciente?')">
              <button type="submit" class="btn btn-danger btn-sm">Excluir</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include("../partials/rodape.ejs") %>