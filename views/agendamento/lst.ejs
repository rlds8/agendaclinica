<%- include("../partials/cabecalho.ejs") %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Agendamentos</h1>
  <a href="/agendamento/add" class="btn btn-primary">+ Novo Agendamento</a>
</div>

<form method="get" action="/agendamento/lst" class="row g-2 mb-3">
  <div class="col-md-5">
    <input type="text" name="pesquisa" class="form-control" placeholder="Pesquisar por paciente ou médico..." value="<%= pesquisa %>">
  </div>
  <div class="col-md-3">
    <select name="status" class="form-select">
      <option value="">Todos os status</option>
      <option value="Agendado" <%= status === "Agendado" ? "selected" : "" %>>Agendado</option>
      <option value="Confirmado" <%= status === "Confirmado" ? "selected" : "" %>>Confirmado</option>
      <option value="Realizado" <%= status === "Realizado" ? "selected" : "" %>>Realizado</option>
      <option value="Cancelado" <%= status === "Cancelado" ? "selected" : "" %>>Cancelado</option>
    </select>
  </div>
  <div class="col-auto">
    <button type="submit" class="btn btn-outline-primary">Filtrar</button>
    <% if (pesquisa || status) { %>
      <a href="/agendamento/lst" class="btn btn-outline-secondary">Limpar</a>
    <% } %>
  </div>
</form>

<div class="table-responsive">
  <table class="table table-striped table-hover bg-white shadow-sm align-middle">
    <thead class="table-primary">
      <tr>
        <th>Paciente</th>
        <th>Médico</th>
        <th>Procedimento</th>
        <th>Data e Hora</th>
        <th>Status</th>
        <th class="text-end">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% if (agendamentos.length === 0) { %>
        <tr>
          <td colspan="6" class="text-center text-muted py-3">Nenhum agendamento encontrado.</td>
        </tr>
      <% } %>
      <% agendamentos.forEach(agendamento => { %>
        <tr>
          <td><%= agendamento.nomePaciente %></td>
          <td><%= agendamento.nomeMedico %></td>
          <td><%= agendamento.tipoProcedimento %></td>
          <td>
            <%= agendamento.dataHora ? agendamento.dataHora.toLocaleString("pt-BR", { timeZone: "America/Sao_Paulo", dateStyle: "short", timeStyle: "short" }) : "" %>
          </td>
          <td>
            <% if (agendamento.status === "Agendado") { %>
              <span class="badge bg-primary">Agendado</span>
            <% } else if (agendamento.status === "Confirmado") { %>
              <span class="badge bg-info text-dark">Confirmado</span>
            <% } else if (agendamento.status === "Realizado") { %>
              <span class="badge bg-success">Realizado</span>
            <% } else { %>
              <span class="badge bg-danger"><%= agendamento.status %></span>
            <% } %>
          </td>
          <td class="text-end">
            <a href="/agendamento/ver/<%= agendamento._id %>" class="btn btn-info btn-sm text-white">Visualizar</a>
            <a href="/agendamento/edt/<%= agendamento._id %>" class="btn btn-warning btn-sm">Editar</a>
            <form method="post" action="/agendamento/del/<%= agendamento._id %>" class="d-inline" onsubmit="return confirm('Deseja realmente excluir este agendamento?')">
              <button type="submit" class="btn btn-danger btn-sm">Excluir</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include("../partials/rodape.ejs") %>